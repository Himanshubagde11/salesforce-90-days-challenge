<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Interview_Date_REQUIRED</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c, &quot;Interviewing&quot;),
 ISBLANK(Interview_Date__c)
)</errorConditionFormula>
    <errorMessage>Interview Date is required when status is Interviewing</errorMessage>
</ValidationRule>
