<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Position_Required_When_Interviewing</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status__c,&quot;Interviewing&quot;) &amp;&amp; ISBLANK(Position__c)</errorConditionFormula>
    <errorMessage>Position is required when applicant is interviewing.</errorMessage>
</ValidationRule>
